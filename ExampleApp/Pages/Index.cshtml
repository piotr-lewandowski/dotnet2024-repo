@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@* <p>
    <a asp-page="Create">Create New</a>
</p> *@
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Comments[0].Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comments[0].Text)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comments[0].Likes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comments[0].PostedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Comments) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Author)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Text)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Likes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PostedAt)
            </td>
            <td>
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
